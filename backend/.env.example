# Environment Configuration Example
# Copy this file to .env and fill in your values

# Application Settings
API_ENV=development
LOG_LEVEL=INFO
APP_NAME=Stock Market Prediction System

# Security - IMPORTANT: Generate a secure secret key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_prediction

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Google Trends API
PYTRENDS_RETRIES=3
PYTRENDS_SLEEP=1

# Market Data
DEFAULT_MARKET_SYMBOL=^NSEI
DEFAULT_START_DATE=2018-01-01
DEFAULT_END_DATE=2025-01-01
SUPPORTED_SYMBOLS=^NSEI,^NSEBANK,^CNXIT

# MLflow (Optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Sentiment Analysis (Optional)
SENTIMENT_API_KEY=

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_SIZE=10485760
