APP_NAME="Stock Market Prediction System"
API_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_prediction

PYTRENDS_RETRIES=3
PYTRENDS_SLEEP=1

DEFAULT_MARKET_SYMBOL=NSEI
DEFAULT_START_DATE=2018-01-01
DEFAULT_END_DATE=2025-01-01

MLFLOW_TRACKING_URI=http://localhost:5000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

SENTIMENT_API_KEY=

SUPPORTED_SYMBOLS=["^NSEI", "^NSEBANK", "^CNXIT"]

# Tests use a separate database:
# DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/stock_prediction_test
